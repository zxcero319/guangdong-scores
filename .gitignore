# === 只跟踪核心文件，忽略其他一切 ===
# 排除所有
/*
/*/

# 白名单：保留
!.gitignore
!CLAUDE.md
!viewer_template.html
!index.html
!dist/
!data/
!scripts/
!README.md

# data/ 下只保留 viewer_data.json
data/*
!data/viewer_data.json

# scripts/ 下只保留重建脚本、工具模块和核心操作脚本
scripts/*
!scripts/_rebuild_viewer.py
!scripts/_viewer_utils.py
!scripts/_field_normalize.py
!scripts/rotate_batch.py
!scripts/ingest_drop.py
!scripts/expire_active.py
!scripts/_sync_gp.py

# dist/ 下只保留 viewer HTML 和 data JSON
dist/*
!dist/guangdong_scores_viewer.html
!dist/viewer_data.json

# Python
__pycache__/
*.pyc
